# Copier vers .env et remplir
# DATABASE_URL : pooler en mode session (port 5432) — voir apps/api/.env.example
# (le pooler en mode transaction, port 6543, casse les transactions interactives).
DATABASE_URL="postgresql://postgres.VOTREPROJET:MOT_DE_PASSE@aws-1-VOTREREGION.pooler.supabase.com:5432/postgres"
# DIRECT_URL : connexion directe, utilisee par Prisma Migrate (prisma migrate dev/deploy)
DIRECT_URL="postgresql://postgres:MOT_DE_PASSE@db.VOTREPROJET.supabase.co:5432/postgres"
