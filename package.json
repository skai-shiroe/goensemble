{
  "name": "goensemble",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "METRO_FILE_MAP_WATCHER_MAX_WAIT_TIME=600000 bun --cwd apps/mobile start",
    "android": "METRO_FILE_MAP_WATCHER_MAX_WAIT_TIME=600000 bun --cwd apps/mobile android",
    "ios": "METRO_FILE_MAP_WATCHER_MAX_WAIT_TIME=600000 bun --cwd apps/mobile ios",
    "api": "bun run --cwd apps/api dev",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd packages/database migrate:dev"
  }
}