# Copier vers .env et remplir vos valeurs
SUPABASE_URL="https://VOTREPROJET.supabase.co"
SUPABASE_ANON_KEY="votre-anon-key"
SUPABASE_SERVICE_ROLE_KEY="votre-service-role-key"

# --- Connexions base de donnees ---
# DATABASE_URL : connexion utilisee par l'API a l'execution.
#   → POOLER EN MODE SESSION (port 5432) : les transactions interactives
#     (anti-surreservation avec SELECT ... FOR UPDATE) ne fonctionnent pas de
#     maniere fiable avec le pooler en mode transaction (port 6543), qui
#     provoque « Transaction already closed » et des connexions laissees en
#     « idle in transaction ».
#   Format : postgresql://postgres.<ref>:<mdp>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.VOTREPROJET:MOT_DE_PASSE@aws-1-VOTREREGION.pooler.supabase.com:5432/postgres"
# DIRECT_URL : connexion directe, utilisee par Prisma Migrate (schema.prisma → directUrl).
DIRECT_URL="postgresql://postgres:MOT_DE_PASSE@db.VOTREPROJET.supabase.co:5432/postgres"
PORT=3000
