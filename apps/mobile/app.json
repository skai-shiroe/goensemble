{
  "expo": {
    "name": "GO Ensemble",
    "slug": "goensemble",
    "version": "1.0.0",
    "scheme": "goensemble",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B7A3B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.goensemble.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d420905d-a2ab-40da-afa0-fc68f61d52da"
      }
    },
    "owner": "skai-devs-team"
  }
}
