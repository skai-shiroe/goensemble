# Copier vers .env (fichier ignore par git).
#
# URL de l'API vue depuis le TELEPHONE : « localhost » ne fonctionne pas, il faut
# l'IP LAN du PC (visible avec `hostname -I`) et que le telephone soit sur le
# meme reseau Wi-Fi. L'API ecoute deja sur 0.0.0.0:3000.
EXPO_PUBLIC_API_URL=http://192.168.1.85:3000
